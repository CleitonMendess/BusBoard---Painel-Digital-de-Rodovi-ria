# Configuração do BusBoard.
#
# Copie este arquivo para .env e ajuste. O .env NÃO vai para o git.
#
#   cp .env.example .env          (Linux/macOS)
#   Copy-Item .env.example .env    (PowerShell)
#
# Tudo aqui tem padrão, menos o SECRET_KEY e o ACCESS_TOKEN_EXPIRE_MINUTES:
# o app não sobe sem os dois, de propósito — são decisões de segurança, e
# é melhor o servidor reclamar na hora do que adivinhar um valor.

# ---------- Autenticação (obrigatório) ----------

# Chave para assinar o JWT. Mínimo de 32 caracteres.
# Gere uma com:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Algoritmo de assinatura do token. Valores válidos: HS256, HS384, HS512.
ALGORITHM=HS256

# Validade do token de acesso, em minutos. Precisa ser maior que zero.
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ---------- Banco de dados ----------

# Mesma string que o Alembic usa. O padrão é o banco local.
# Para apontar para outro lugar (ex.: em outro disco), mude aqui também.
DATABASE_URL=sqlite:///banco.db

# ---------- Front-end (CORS) ----------

# Quem pode chamar a API, separado por vírgula. Em desenvolvimento o Vite
# fica em 5173; em produção, ponha o domínio real do painel.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------- Reinício diário da grade ----------

# Hora (0-23) em que as viagens voltam para AGENDADO e a previsão de horário
# é apagada. O "dia" da rodoviária começa nessa hora, não à meia-noite.
DAILY_RESET_HOUR=3

# Fuso usado para decidir o dia. O Brasil não tem horário de verão hoje,
# então UTC-3 fixo funciona; o padrão usa a base de fusos do sistema.
TZ_NAME=America/Sao_Paulo

# ---------- Trava de tentativas de login ----------

# Falhas permitidas antes de travar, em quanto tempo as falhas somem e
# quanto tempo fica travado. O contador fica na memória do processo: se um
# dia rodar com vários workers, o lugar certo é o banco ou o Redis.
LOGIN_MAX_TENTATIVAS=5
LOGIN_JANELA_SEGUNDOS=300
LOGIN_BLOQUEIO_SEGUNDOS=60
